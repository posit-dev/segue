# >>> per-method
{{name}}_{{method}} <- function(
  {{data summaries}},
  options = list(),
  settings = list()
) {
  # TODO (only if the engine does not exist yet): implement {{engine}}.
  cl <- rlang::call2(
    "{{engine function}}",
    .ns = "{{engine namespace}}",
    {{engine data arguments, such as x = num_events, n = num_total}},
    !!!options
    {{, fixed engine arguments, such as correct = FALSE}}
  )
  res <- try(rlang::eval_tidy(cl), silent = TRUE)
  if (inherits(res, "try-error")) {
    cli::cli_abort(
      "{.fn {{name}}} with {.code method = '{{method}}'} failed with error: {res}",
      call = NULL
    )
  }

  # Arguments for sas_proc(); use list() when there is no SAS equivalent.
  # Build option-dependent statements from the segue-side `settings`, one
  # temporary variable at a time (no inline if/else). Note options that have
  # no SAS equivalent in a comment here.
  {{for example:
  sas_options <- paste0("p=", settings$null_value, " level=\"", settings$event_level, "\"")
  }}
  sas_code <- list(
    proc = "{{proc}}",
    {{other sas_proc() statements, such as
    tables = paste0("&var / binomial(", sas_options, ")"),
    exact = "binomial"}}
  )

  list(results = res, code = list(r = cl, sas = sas_code))
}
# <<< per-method
