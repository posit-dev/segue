test_that("{{name}}() creates SAS code", {
  {{y}} <- {{small valid data}}

  # >>> per-method with SAS code
  expect_snapshot(
    rlang::exec("sas_proc", !!!{{name}}({{y}}, method = "{{method}}")$code$sas)
  )
  expect_snapshot(
    rlang::exec(
      "sas_proc",
      !!!{{name}}({{y}}, method = "{{method}}", {{non-default options}})$code$sas
    )
  )
  # <<< per-method with SAS code
})

test_that("{{name}}() print method", {
  {{y}} <- {{data with no missing values}}
  {{y}}_one <- {{data with one missing value}}
  {{y}}_miss <- {{data with two missing values}}

  expect_snapshot(res <- print({{name}}({{y}})))
  expect_s3_class(res, "{{name}}")
  expect_snapshot(print({{name}}({{y}}_one)))
  expect_snapshot(print({{name}}({{y}}_miss)))
})
