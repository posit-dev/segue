test_that("{{name}}() returns a segue object", {
  {{y}} <- {{small inline data with one NA}}
  res <- {{name}}({{y}})

  expect_s3_class(res, c("{{name}}", "segue_object"))
  expect_named(res, c("code", "results", "options", "data_characteristics"))
  expect_named(res$code, c("r", "sas"))
  expect_equal(
    res$options,
    list(
      method = "{{default method}}",
      {{default option values}}
    )
  )
  expect_equal(res$data_characteristics$missing, 1L)
  {{expect_equal() for each data summary}}
  expect_s3_class(res$results, "{{results class, such as htest}}")
  expect_equal(
    res$code$r,
    rlang::call2(
      "{{engine function}}",
      .ns = "{{engine namespace}}",
      {{expected engine arguments}}
    )
  )
})

test_that("{{name}}() passes options to the engine", {
  {{y}} <- {{small inline data without NA}}
  res <- {{name}}({{y}}, {{non-default option values}})

  expect_equal(res$data_characteristics$missing, 0L)
  expect_equal(
    res$results{{$statistic of interest}},
    {{direct engine call with the same options}}{{$statistic of interest}}
  )
})

