test_that("{{name}}() validates inputs", {
  {{y}} <- {{small valid data}}

  expect_snapshot(error = TRUE, {{name}}({{object with no method}}))
  expect_snapshot(error = TRUE, {{name}}({{y}}, method = "{{bad method}}"))
  {{one expect_snapshot(error = TRUE, ...) per argument validation rule}}
