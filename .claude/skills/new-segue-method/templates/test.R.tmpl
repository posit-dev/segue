test_that("{{name}}() can use method = '{{method}}'", {
  # skip("until {{engine}} is available")  # keep only if the engine is missing
  {{y}} <- {{small inline data with NA}}
  res <- {{name}}({{y}}, method = "{{method}}", {{option values}})

  expect_s3_class(res, c("{{name}}", "segue_object"))
  expect_equal(res$options$method, "{{method}}")
  expect_equal(
    res$results{{$statistic of interest}},
    {{direct engine call}}{{$statistic of interest}}
  )
  expect_equal(
    res$code$r,
    rlang::call2(
      "{{engine function}}",
      .ns = "{{engine namespace}}",
      {{expected engine arguments}}
    )
  )
  expect_equal(res$code$sas, list({{expected sas_proc() arguments}}))
})
